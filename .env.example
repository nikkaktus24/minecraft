# Copy to `.env` for `docker compose up`, or paste these into Portainer →
# Stack → Environment variables. Do not commit a real `.env`.

# Required. Must be TRUE or the container will refuse to start.
EULA=FALSE

# JVM heap. This pack is sized for 4–6G; 5G is the default.
MEMORY=5G

# Host port published to the container's 25565/tcp.
SERVER_PORT=25565

# Forge build for Minecraft 1.20.1. 47.4.20 matches the IC2 / Advanced Machines
# / Advanced Solar Panels Gradle pins. Later 47.4.x is expected to work.
FORGE_VERSION=47.4.20

# Named-volume prefix (world, mods, config, logs, plus leftover /data).
VOLUME_PREFIX=mc-ic2

# Process identity inside the container (match a host user if you bind-mount).
UID=1000
GID=1000
TZ=UTC

# Vanilla server.properties (written by itzg on each start).
MOTD=IC2 Refactored 1.20.1
DIFFICULTY=normal
MODE=survival
ONLINE_MODE=true
MAX_PLAYERS=20
VIEW_DISTANCE=10
SIMULATION_DISTANCE=10
LEVEL=world

# Disable the vanilla watchdog for modded ticks. Set a millisecond budget if
# you prefer it enabled (vanilla default is 60000).
MAX_TICK_TIME=-1

USE_AIKAR_FLAGS=true

# RCON is used by the image for graceful `stop`. Do not publish 25575.
ENABLE_RCON=true
RCON_PASSWORD=minecraft

# --- Optional / not required for this stack ---
#
# Split heap (overrides MEMORY). Add matching keys under `environment:` in
# docker-compose.yml if you want them, e.g. INIT_MEMORY=4G and MAX_MEMORY=6G.
# INIT_MEMORY=4G
# MAX_MEMORY=6G
#
# CurseForge API key — only if you later switch to CURSEFORGE_FILES /
# AUTO_CURSEFORGE. This stack downloads from GitHub + Modrinth CDN instead.
# CF_API_KEY=
#
# Modrinth token — only for private/rate-limited Modrinth downloads.
# MODRINTH_TOKEN=
