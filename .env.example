# Copy to `.env` for `docker compose up`, or paste these into Portainer →
# Stack → Environment variables. Do not commit a real `.env`.

# Mojang Minecraft EULA (https://aka.ms/MinecraftEULA). itzg requires this
# TRUE or the container exits. Distinct from ONLINE_MODE (cracked join).
# Compose already defaults EULA to TRUE so a Portainer Git/paste stack boots
# without copying this file. Override with EULA=FALSE if you must refuse.
EULA=TRUE

# JVM heap. This pack is sized for 4–6G; 5G is the default.
MEMORY=5G

# Host port published to the container's 25565/tcp.
SERVER_PORT=25565

# Forge build for Minecraft 1.20.1. 47.4.20 matches the IC2 / Advanced Machines
# / Advanced Solar Panels Gradle pins. Later 47.4.x is expected to work.
FORGE_VERSION=47.4.20

# Named-volume prefix. One volume `${VOLUME_PREFIX}-data` mounts at /data
# (world, mods, config, logs, Forge all live inside it).
VOLUME_PREFIX=mc-ic2

# Process identity after itzg drops root. Do not also set compose/Portainer
# "user" to 1000:1000 — that blocks the startup chown of /data.
UID=1000
GID=1000
TZ=UTC

# Vanilla server.properties (written by itzg on each start).
MOTD=IC2 1.20.1 — /login after join
DIFFICULTY=normal
MODE=survival
# false = cracked / no Microsoft account (everyone can join). EULA above is still required.
ONLINE_MODE=false
# Must be false when ONLINE_MODE=false, or cracked clients fail chat/login.
ENFORCE_SECURE_PROFILE=false
MAX_PLAYERS=3
VIEW_DISTANCE=10
SIMULATION_DISTANCE=10
LEVEL=world

# Join password for friends (vanilla has none). After connect they type:
#   first time:  /login ic2play ic2play
#   later:       /login ic2play
# Change this in Portainer before going live. Do not put it in the MOTD.
SERVER_PASSWORD=ic2play

# Disable the vanilla watchdog for modded ticks. Set a millisecond budget if
# you prefer it enabled (vanilla default is 60000).
MAX_TICK_TIME=-1

USE_AIKAR_FLAGS=true

# RCON is used by the image for graceful `stop`. Do not publish 25575.
ENABLE_RCON=true
RCON_PASSWORD=ic2rcon

# --- Optional / not required for this stack ---
#
# Split heap (overrides MEMORY). Add matching keys under `environment:` in
# docker-compose.yml if you want them, e.g. INIT_MEMORY=4G and MAX_MEMORY=6G.
# INIT_MEMORY=4G
# MAX_MEMORY=6G
#
# CurseForge API key — only if you later switch to CURSEFORGE_FILES /
# AUTO_CURSEFORGE. This stack downloads from GitHub + Modrinth CDN instead.
# CF_API_KEY=
#
# Modrinth token — only for private/rate-limited Modrinth downloads.
# MODRINTH_TOKEN=
